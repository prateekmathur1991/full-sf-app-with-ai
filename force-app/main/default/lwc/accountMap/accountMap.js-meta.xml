<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>58.0</apiVersion>
    <description>Lightning Web Component for displaying Salesforce accounts on an interactive map with distance-based search functionality</description>
    <isExposed>true</isExposed>
    <masterLabel>Account Map</masterLabel>
    <targets>
        <target>lightning__AppPage</target>
        <target>lightning__HomePage</target>
        <target>lightning__RecordPage</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__AppPage,lightning__HomePage">
            <property name="title" type="String" label="Title" description="Title of the component" default="Account Map"/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
