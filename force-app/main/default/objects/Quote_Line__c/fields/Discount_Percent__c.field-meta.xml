<?xml version="1.0" encoding="UTF-8" ?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Discount_Percent__c</fullName>
    <description
  >Unit discount as a percentage of unit list price. Zero when list price is zero, negative for a markup.</description>
    <formula
  >IF(List_Price__c = 0, 0, (List_Price__c - Negotiated_Price__c) / List_Price__c)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Discount %</label>
    <precision>18</precision>
    <required>false</required>
    <scale>2</scale>
    <type>Percent</type>
</CustomField>
